MOMO_PROFILE=development
MOMO_DATABASE_URL=sqlite:///./data/momo.db
MOMO_LOCAL_DISPATCH=true
MOMO_JWT_SECRET=
MOMO_MODEL_ROOT=data/models
MOMO_STORAGE_ROOT=data/objects
MOMO_INFERENCE_DEVICE=cpu
# Optional Video Lab original-file limits (designer source packages keep their own limit):
# MOMO_LAB_MAX_AUDIO_BYTES=10000000000
# MOMO_LAB_MAX_SECONDS=21600
# MOMO_LAB_TEMP_ROOT=D:/MOMO_Development/lab-temp
# Video Lab local Whisper/Qwen execution (gpu default, cpu for explicit comparison):
# MOMO_LAB_DEVICE=gpu
# Windows optional CUDA DLL package directory:
# MOMO_CUDA_LIBRARY_ROOT=D:/MOMO_Development/cuda-runtime
# Production uses PostgreSQL, Redis, and TLS at the reverse proxy.
# MOMO_DATABASE_URL=postgresql+psycopg://momo:URL_ENCODED_PASSWORD@postgres:5432/momo
# MOMO_BROKER_URL=redis://redis:6379/0
# MOMO_PROFILE=production
# MOMO_LOCAL_DISPATCH=false
