{
  "$defs": {
    "SpeakerTrack": {
      "additionalProperties": false,
      "properties": {
        "speaker_id": {
          "title": "Speaker Id",
          "type": "string"
        },
        "activity": {
          "items": {
            "type": "number"
          },
          "title": "Activity",
          "type": "array"
        },
        "laughter_activity": {
          "items": {
            "type": "number"
          },
          "title": "Laughter Activity",
          "type": "array"
        },
        "energy_source": {
          "const": "activity_weighted_mixture",
          "default": "activity_weighted_mixture",
          "title": "Energy Source",
          "type": "string"
        }
      },
      "required": [
        "speaker_id",
        "activity",
        "laughter_activity"
      ],
      "title": "SpeakerTrack",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "duration_us": {
      "maximum": 600000000,
      "minimum": 100000,
      "title": "Duration Us",
      "type": "integer"
    },
    "frame_step_us": {
      "const": 20000,
      "default": 20000,
      "title": "Frame Step Us",
      "type": "integer"
    },
    "frame_count": {
      "exclusiveMinimum": 0,
      "title": "Frame Count",
      "type": "integer"
    },
    "mixed_voice_energy": {
      "items": {
        "type": "number"
      },
      "title": "Mixed Voice Energy",
      "type": "array"
    },
    "speaker_tracks": {
      "items": {
        "$ref": "#/$defs/SpeakerTrack"
      },
      "title": "Speaker Tracks",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "duration_us",
    "frame_count",
    "mixed_voice_energy",
    "speaker_tracks"
  ],
  "title": "MotionTracks",
  "type": "object"
}
