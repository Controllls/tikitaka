{
  "$defs": {
    "HighlightClip": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "maximum": 3,
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "exclusiveMinimum": 0,
          "maximum": 80000000,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "number",
        "title",
        "start_ms",
        "end_ms",
        "score",
        "sha256",
        "size"
      ],
      "title": "HighlightClip",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "audio_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Audio Sha256",
      "type": "string"
    },
    "duration_ms": {
      "exclusiveMinimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "threshold": {
      "const": 0.1,
      "default": 0.1,
      "title": "Threshold",
      "type": "number"
    },
    "data_origin": {
      "enum": [
        "inference",
        "fixture"
      ],
      "title": "Data Origin",
      "type": "string"
    },
    "clips": {
      "items": {
        "$ref": "#/$defs/HighlightClip"
      },
      "maxItems": 3,
      "title": "Clips",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "audio_sha256",
    "duration_ms",
    "data_origin",
    "clips"
  ],
  "title": "HighlightResult",
  "type": "object"
}
