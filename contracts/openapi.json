  "components": {
    "schemas": {
      "AnalysisResult": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "pipeline_version": {
            "type": "string",
            "const": "momo-server-v1",
            "title": "Pipeline Version",
            "default": "momo-server-v1"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "duration_us": {
            "type": "integer",
            "maximum": 600000000.0,
            "minimum": 100000.0,
            "title": "Duration Us"
          },
          "data_origin": {
            "type": "string",
            "enum": [
              "inference",
              "fixture"
            ],
            "title": "Data Origin"
          },
          "audio": {
            "$ref": "#/components/schemas/AudioInfo"
          },
          "speakers": {
            "items": {
              "$ref": "#/components/schemas/Speaker"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Speakers"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "title": "Events"
          },
          "captions": {
            "items": {
              "$ref": "#/components/schemas/Caption"
            },
            "type": "array",
            "title": "Captions"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelInfo"
            },
            "type": "array",
            "title": "Models"
          },
          "tracks": {
            "$ref": "#/components/schemas/TrackRef"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/Warning"
            },
            "type": "array",
            "title": "Warnings"
          },
          "voice_model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice Model Id"
          },
          "speaker_signatures": {
            "items": {
              "$ref": "#/components/schemas/SpeakerSignature"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Speaker Signatures"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "duration_us",
          "data_origin",
          "audio",
          "speakers",
          "events",
          "captions",
          "models",
          "tracks"
        ],
        "title": "AnalysisResult"
      },
      "AudioInfo": {
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256"
          },
          "original_mime": {
            "type": "string",
            "title": "Original Mime"
          },
          "analysis_sample_rate": {
            "type": "integer",
            "const": 16000,
            "title": "Analysis Sample Rate",
            "default": 16000
          },
          "analysis_channels": {
            "type": "integer",
            "const": 1,
            "title": "Analysis Channels",
            "default": 1
          },
          "decoded_time_origin_us": {
            "type": "integer",
            "const": 0,
            "title": "Decoded Time Origin Us",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sha256",
          "original_mime"
        ],
        "title": "AudioInfo"
      },
      "Body_submit_v1_analyses_post": {
        "properties": {
          "audio": {
            "type": "string",
            "format": "binary",
            "title": "Audio"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "options": {
            "type": "string",
            "title": "Options"
          }
        },
        "type": "object",
        "required": [
          "audio",
          "sha256",
          "options"
        ],
        "title": "Body_submit_v1_analyses_post"
      },
      "Body_submit_v1_highlights_post": {
        "properties": {
          "audio": {
            "type": "string",
            "format": "binary",
            "title": "Audio"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "options": {
            "type": "string",
            "title": "Options"
          }
        },
        "type": "object",
        "required": [
          "audio",
          "sha256",
          "options"
        ],
        "title": "Body_submit_v1_highlights_post"
      },
      "Caption": {
        "properties": {
          "start_us": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Us"
          },
          "end_us": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "End Us"
          },
          "caption_id": {
            "type": "string",
            "title": "Caption Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "speaker_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Speaker Ids"
          },
          "requires_review": {
            "type": "boolean",
            "title": "Requires Review",
            "default": false
          },
          "words": {
            "items": {
              "$ref": "#/components/schemas/Word"
            },
            "type": "array",
            "title": "Words"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start_us",
          "end_us",
          "caption_id",
          "text"
        ],
        "title": "Caption"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": false
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id",
