* text=auto

# Keep the Gradle launcher usable on Unix and Windows.
gradlew text eol=lf
*.bat text eol=crlf

# Source and documentation use consistent line endings.
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

*.jar binary
*.png binary
*.webp binary
