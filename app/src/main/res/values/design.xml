<resources>
    <dimen name="page_padding">20dp</dimen>
    <dimen name="headline_size">28sp</dimen>
    <dimen name="recorder_size">300dp</dimen>
    <integer name="wide_footer_visibility">8</integer>
    <style name="Shape.Journal" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ThemeOverlay.Journal.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/card_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.Journal.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Widget.Journal.DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Journal.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Journal.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Journal.DialogButton</item>
    </style>
    <style name="Widget.Journal.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="Widget.Journal.DialogBody" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingExtra">5dp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Widget.Journal.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textSize">17sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">@color/sample_primary</item>
    </style>
    <style name="Text.Journal" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Journal.Title">
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Journal.Headline">
        <item name="android:textSize">@dimen/headline_size</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Journal.Section">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Journal.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.Journal.Eyebrow">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>
    <style name="Widget.Journal.Card" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.Journal.Navigation" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:minWidth">112dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">12dp</item>
    </style>
    <style name="Widget.Journal.Navigation.Selected">
        <item name="android:textColor">@color/sample_primary</item>
        <item name="backgroundTint">@color/accent_surface</item>
        <item name="iconTint">@color/sample_primary</item>
    </style>
</resources>
