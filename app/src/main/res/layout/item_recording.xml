<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:minHeight="64dp" android:padding="16dp"
    android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/item_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="20sp" />
    <TextView android:id="@+id/item_details" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" />
</LinearLayout>
