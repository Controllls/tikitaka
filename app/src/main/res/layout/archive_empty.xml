<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.Journal.Card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="32dp" android:gravity="center" android:minHeight="380dp">
        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:padding="22dp"
            android:src="@drawable/ic_audio" app:tint="@color/sample_primary"
            android:background="@drawable/bg_accent_tile" android:importantForAccessibility="no" />
        <TextView style="@style/Text.Journal.Section" android:text="@string/archive_empty_title"
            android:layout_marginTop="28dp" android:gravity="center" />
        <TextView style="@style/Text.Journal.Body" android:text="@string/archive_empty_description"
            android:layout_marginTop="12dp" android:gravity="center" />
        <com.google.android.material.button.MaterialButton android:id="@+id/return_to_recorder"
            style="@style/Widget.Journal.Navigation.Selected" android:text="@string/return_to_recorder"
            android:layout_marginTop="24dp" app:icon="@drawable/ic_mic" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
